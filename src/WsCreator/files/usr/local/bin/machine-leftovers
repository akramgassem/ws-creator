#!/usr/bin/env bash
# What would be lost if the machine were deleted now.
# "!" lines: work to push (exit code 1, purge refuses).
# "·" lines: content of ~/scratch outside git, lost with the machine (for the record).
# Used as is by "ws-creator purge" and "ws-creator status", installed by the guard module.
set -uo pipefail
home=$(getent passwd "$(id -un)" | cut -d: -f6)
lost=0

while read -r git; do
    repo=${git%/.git}
    name=${repo#"$home"/}
    [ -n "$(git -C "$repo" status --porcelain 2>/dev/null | head -n1)" ] && { echo "! $name: uncommitted changes"; lost=1; }
    n=$(git -C "$repo" stash list 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && { echo "! $name: $n stash"; lost=1; }
    # commits on a local branch and on no known remote branch
    while read -r branch; do
        n=$(git -C "$repo" rev-list --count "refs/heads/$branch" --not --remotes 2>/dev/null || echo 0)
        [ "$n" -gt 0 ] || continue
        if git -C "$repo" rev-parse --abbrev-ref "$branch@{upstream}" >/dev/null 2>&1; then
            echo "! $name: $branch, $n unpushed commit(s)"
        else
            echo "! $name: $branch, $n commit(s) on a branch without upstream"
        fi
        lost=1
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)
done < <(find "$home/src" "$home/scratch" -maxdepth 5 -name .git -prune 2>/dev/null | sort)

# ~/scratch/<topic> without a git repo: throwaway by convention, listed for a decision
for dir in "$home"/scratch/*/; do
    [ -d "$dir" ] || continue
    [ -e "$dir/.git" ] && continue
    find "$dir" -maxdepth 4 -name .git -prune 2>/dev/null | grep -q . && continue
    last=$(find "$dir" -type f -printf '%TY-%Tm-%Td\n' 2>/dev/null | sort -r | head -n1)
    [ -n "$last" ] && echo "· ${dir#"$home"/}: outside git, modified $last"
done

exit $lost
