#!/usr/bin/env bash
# Ce qui serait perdu si la machine était effacée maintenant.
# Lignes « ! » : travail à pousser (code de sortie 1, purge refuse).
# Lignes « · » : contenu de ~/scratch hors git, perdu avec la machine (pour mémoire).
# Utilisé tel quel par « ws-creator.ps1 purge » et « ws-creator.ps1 status », installé par le module guard.
set -uo pipefail
home=$(getent passwd "$(id -un)" | cut -d: -f6)
lost=0

while read -r git; do
    repo=${git%/.git}
    name=${repo#"$home"/}
    [ -n "$(git -C "$repo" status --porcelain 2>/dev/null | head -n1)" ] && { echo "! $name : modifications non commitées"; lost=1; }
    n=$(git -C "$repo" stash list 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && { echo "! $name : $n stash"; lost=1; }
    # commits présents sur une branche locale et sur aucune branche distante connue
    while read -r branch; do
        n=$(git -C "$repo" rev-list --count "refs/heads/$branch" --not --remotes 2>/dev/null || echo 0)
        [ "$n" -gt 0 ] || continue
        if git -C "$repo" rev-parse --abbrev-ref "$branch@{upstream}" >/dev/null 2>&1; then
            echo "! $name : $branch, $n commit(s) non poussé(s)"
        else
            echo "! $name : $branch, $n commit(s) sur une branche sans upstream"
        fi
        lost=1
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)
done < <(find "$home/src" "$home/scratch" -maxdepth 5 -name .git -prune 2>/dev/null | sort)

# ~/scratch/<sujet> sans dépôt git : jetable par convention, listé pour décision
for dir in "$home"/scratch/*/; do
    [ -d "$dir" ] || continue
    [ -e "$dir/.git" ] && continue
    find "$dir" -maxdepth 4 -name .git -prune 2>/dev/null | grep -q . && continue
    last=$(find "$dir" -type f -printf '%TY-%Tm-%Td\n' 2>/dev/null | sort -r | head -n1)
    [ -n "$last" ] && echo "· ${dir#"$home"/} : hors git, modifié le $last"
done

exit $lost
