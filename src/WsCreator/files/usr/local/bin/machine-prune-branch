#!/usr/bin/env bash
# Deletes a branch, local and remote (origin), only if its GitHub PR is merged.
#   machine-prune-branch [--check] <repo> <branch>
# Refuses: main branch, branch checked out in a worktree, PR open or missing, local or remote
# commit that is not in the merged PR (squash merges included).
# --check: verdict only, nothing is deleted. Exit 0: prunable (or pruned), 1: kept.
# Used by /tidy and machine-crumbs. It is the only branch deletion Claude's settings allow
# without confirmation (agent module): the check lives here. Hooks still run (no
# --no-verify). Installed by the guard module.
set -uo pipefail
home=$(getent passwd "$(id -un)" | cut -d: -f6)
export PATH="$home/.local/share/mise/shims:$PATH"
. "$(dirname "$(readlink -f "$0")")/../lib/ws-creator/git-hooks/common.sh"

check=0
[ "${1:-}" = --check ] && { check=1; shift; }
[ $# -eq 2 ] || { echo "usage: machine-prune-branch [--check] <repo> <branch>" >&2; exit 2; }
repo=$1 branch=$2
keep() { echo "kept: $branch, $*"; exit 1; }

git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || keep "$repo is not a git repo"
default=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
case "$branch" in "${default#origin/}"|main|master) keep "main branch" ;; esac
git -C "$repo" worktree list --porcelain | grep -qxF "branch refs/heads/$branch" && keep "checked out in a worktree"

slug=$(github_slug "$(git -C "$repo" remote get-url origin 2>/dev/null)")
[ -n "$slug" ] || keep "origin is not on GitHub"
command -v gh >/dev/null || keep "gh missing"
prs=$(timeout 15 gh pr list --repo "$slug" --head "$branch" --state all --json number,state,headRefOid \
    --jq '.[] | "\(.state) \(.number) \(.headRefOid)"' 2>/dev/null < /dev/null) || keep "PR state unknown (gh)"
grep -q '^OPEN ' <<< "$prs" && keep "PR open"
merged=$(grep '^MERGED ' <<< "$prs")
[ -n "$merged" ] || keep "no merged PR"

# merged PR that contains commit $1 (the PR's last commit, or one of its ancestors)
covering_pr() {
    local _ n head
    while read -r _ n head; do
        if [ "$1" = "$head" ] || { git -C "$repo" cat-file -e "$head^{commit}" 2>/dev/null &&
            git -C "$repo" merge-base --is-ancestor "$1" "$head" 2>/dev/null; }; then
            echo "#$n"; return 0
        fi
    done <<< "$merged"
    return 1
}

local_tip=$(git -C "$repo" rev-parse -q --verify "refs/heads/$branch")
remote_tip=$(timeout 15 git -C "$repo" ls-remote --heads origin "refs/heads/$branch" 2>/dev/null < /dev/null) ||
    keep "origin unreachable"
remote_tip=$(cut -f1 <<< "$remote_tip")
[ -n "$local_tip$remote_tip" ] || keep "neither local nor on origin"
pr=""
if [ -n "$local_tip" ]; then pr=$(covering_pr "$local_tip") || keep "local commits not in the merged PRs"; fi
if [ -n "$remote_tip" ]; then pr=$(covering_pr "$remote_tip") || keep "commits on origin not in the merged PRs"; fi
where=$(echo "${local_tip:+local}${local_tip:+${remote_tip:+, }}${remote_tip:+origin}")

if [ $check = 1 ]; then echo "prunable: $branch, PR $pr merged ($where)"; exit 0; fi
if [ -n "$remote_tip" ]; then
    git -C "$repo" push --quiet origin --delete "$branch" < /dev/null || keep "deletion on origin refused"
fi
if [ -n "$local_tip" ]; then
    git -C "$repo" branch --quiet -D "$branch" || keep "local deletion refused"
fi
echo "pruned: $branch, PR $pr merged ($where)"
