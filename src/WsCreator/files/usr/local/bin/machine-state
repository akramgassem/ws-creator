#!/usr/bin/env bash
# Machine state in a few lines: containers, GitHub, repos in ~/src and ~/scratch, crumbs.
# Readable by a human as well as an agent (session start hook). Installed by the guard
# module. Does not query the network, except `gh auth status`.
set -uo pipefail
home=$(getent passwd "$(id -un)" | cut -d: -f6)
export PATH="$home/.local/share/mise/shims:$PATH"

echo "Machine $(hostname) ($(cat /etc/ws-creator-profile 2>/dev/null || echo 'not from ws-creator'))"

# project services (each repo's compose.yaml): what is running, if the socket is reachable
if command -v docker >/dev/null && running=$(docker ps --format '{{.Names}}' 2>/dev/null); then
    running=${running//$'\n'/ }
    echo "Containers: ${running:-none}"
fi

if command -v gh >/dev/null; then
    if gh auth status --hostname github.com >/dev/null 2>&1; then echo "GitHub (gh): logged in"
    else echo "GitHub (gh): NOT LOGGED IN (gh auth login)"; fi
fi
if command -v chezmoi >/dev/null && [ ! -d "$home/.local/share/chezmoi" ]; then
    echo "Dotfiles: not applied (gh auth login, then chezmoi init --apply <account>)"
fi

echo "Repos (branch, local state; no git fetch):"
found=0
while read -r git; do
    found=1
    repo=${git%/.git}
    branch=$(git -C "$repo" branch --show-current 2>/dev/null)
    [ -n "$branch" ] || branch="(detached $(git -C "$repo" rev-parse --short HEAD 2>/dev/null))"
    notes=()
    n=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && notes+=("$n modified file(s)")
    track=$(git -C "$repo" for-each-ref --format='%(upstream:short)|%(upstream:track)' "refs/heads/$branch" 2>/dev/null)
    case "$track" in
        "") ;;
        "|"*) notes+=("no upstream") ;;
        *"[gone]"*) notes+=("upstream deleted (PR merged?)") ;;
        *"["*) notes+=("${track#*|}") ;;
    esac
    n=$(git -C "$repo" stash list 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && notes+=("$n stash")
    line="  ${repo#"$home"/}: $branch"
    [ ${#notes[@]} -gt 0 ] && line="$line, $(IFS=,; echo "${notes[*]}" | sed 's/,/, /g')"
    echo "$line"
done < <(find "$home/src" "$home/scratch" -maxdepth 5 -name .git -prune 2>/dev/null | sort)
[ $found = 1 ] || echo "  (none)"

# crumbs left by sessions (local signals only): /tidy picks them up
command -v machine-crumbs >/dev/null && machine-crumbs --local --summary
true
