#!/usr/bin/env bash
# Refuse de pousser sur une branche dont la pull request GitHub est déjà fusionnée : les
# commits n'arriveraient jamais sur la branche principale. Sans réseau ni gh, laisse passer.
# $1 : remote, $2 : URL ; entrée standard : <ref locale> <sha> <ref distante> <sha>
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/common.sh"

slug=$(github_slug "$2")
[ -n "$slug" ] || exit 0
command -v gh >/dev/null || exit 0
status=0

while read -r _ local_sha remote_ref _; do
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    [ "${local_sha//0/}" = "" ] && continue   # suppression de branche
    branch=${remote_ref#refs/heads/}
    if ! prs=$(timeout 15 gh pr list --repo "$slug" --head "$branch" --state all \
        --json number,state --jq '.[] | "\(.state) #\(.number)"' 2>/dev/null < /dev/null); then
        fail "état des PR de $branch inconnu (gh), poussé sans contrôle"
        continue
    fi
    grep -q '^OPEN ' <<< "$prs" && continue
    merged=$(grep '^MERGED ' <<< "$prs" | cut -d' ' -f2 | paste -sd' ')
    if [ -n "$merged" ]; then
        fail "la PR $merged de la branche $branch est déjà fusionnée : ces commits ne seraient pas sur la branche principale."
        fail "Créer une nouvelle branche depuis la principale (git cherry-pick) et ouvrir une nouvelle PR."
        status=1
    fi
done

exit $status
