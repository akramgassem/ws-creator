#!/usr/bin/env bash
# core.hooksPath (system git config) points to /etc/ws-creator/hooks, where each hook is a
# link to this script: it runs the ws-creator check of the same name, if any, then the repo's
# hook (.git/hooks/<name>), which core.hooksPath would hide otherwise.
set -uo pipefail
name=$(basename "$0")
here=$(dirname "$(readlink -f "$0")")
home=$(getent passwd "$(id -un)" | cut -d: -f6)
export PATH="$home/.local/bin:$home/.local/share/mise/shims:$PATH"   # mise (repo hooks), gitleaks, gh

# stdin of the hooks that have one: read once, replayed for each hook
stdin=$(mktemp)
trap 'rm -f "$stdin"' EXIT
case "$name" in pre-push | post-rewrite) cat > "$stdin" ;; esac

if [ "$name" != dispatch ] && [ -x "$here/$name" ]; then
    "$here/$name" "$@" < "$stdin" || exit $?
fi
repo_hook="$(git rev-parse --git-common-dir)/hooks/$name"
if [ -x "$repo_hook" ]; then
    "$repo_hook" "$@" < "$stdin" || exit $?
fi
exit 0
